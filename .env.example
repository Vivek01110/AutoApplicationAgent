# ---- Environment ----
GOVFLOW_ENV=dev                 # dev | test | prod
LOG_LEVEL=INFO

# ---- LLM Configuration (Anthropic or Google Gemini) ----
LLM_PROVIDER=gemini             # gemini | anthropic
# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=2048
LLM_EFFORT=medium               # low | medium | high | xhigh | max
LLM_REFUSAL_FALLBACK=true       # server-side refusal fallback (Claude API only)
LLM_INPUT_COST_PER_MTOK=2.0
LLM_OUTPUT_COST_PER_MTOK=10.0
LLM_CACHE_READ_COST_PER_MTOK=0.2
WEB_SEARCH_COST_PER_1K=10.0

# ---- Service discovery ----
SEARCH_PROVIDER=anthropic       # anthropic | tavily | brave
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARCH_MAX_RESULTS=8
RESOLVER_MAX_CANDIDATES=5
RESOLVER_MIN_CONFIDENCE=0.75
EXTRA_OFFICIAL_DOMAINS=         # comma-separated official domains outside .gov.in/.nic.in/.gov
INSECURE_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Polite web access ----
HTTP_TIMEOUT_SECONDS=15
ACTION_DELAY_MIN_SECONDS=1.0
ACTION_DELAY_MAX_SECONDS=3.0

# ---- Form planner ----
PLANNER_MAX_FORM_PAGES=8
PLANNER_MAX_INFO_PAGES=4
PLANNER_MAX_CLICKS=12
PLANNER_PAGE_TIMEOUT_SECONDS=30

# ---- Speech-to-text ----
TRANSCRIBER=openai              # openai | faster_whisper
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
FASTER_WHISPER_MODEL=small

# ---- Intake ----
CONFIDENCE_THRESHOLD=0.85
MAX_UPLOAD_BYTES=10485760

# ---- Agent limits ----
AGENT_MAX_STEPS=60
AGENT_MAX_COST_USD=2.0
AGENT_MAX_SAME_ACTION_FAILURES=3
HUMAN_WAIT_TIMEOUT_SECONDS=600
EXTRA_ALLOWED_DOMAINS=          # comma-separated, e.g. cdn.example.gov.in

# ---- Browser ----
BROWSER_HEADLESS=true
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800
SCREENCAST_QUALITY=60
SCREENCAST_MAX_FPS=10

# ---- Testbed portals (Phase 9, evals/regression only) ----
PORTAL_SCHOLARSHIP_URL=http://localhost:5001
PORTAL_LICENSE_URL=http://localhost:5002
PORTAL_SUBSIDY_URL=http://localhost:5003

# ---- Security / storage ----
# Comma-separated Fernet keys; the first encrypts, all decrypt (rotation).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required when GOVFLOW_ENV=prod. In dev a key is auto-generated under GOVFLOW_DATA_DIR.
GOVFLOW_MASTER_KEYS=
GOVFLOW_DATA_DIR=./data

# ---- API ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
